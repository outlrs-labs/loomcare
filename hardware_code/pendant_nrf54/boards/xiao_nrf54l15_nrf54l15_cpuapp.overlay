#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	zephyr,user {
		button-gpios = <&xiao_d 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		motor-gpios = <&xiao_d 1 GPIO_ACTIVE_HIGH>;
		led-gpios = <&xiao_d 3 GPIO_ACTIVE_HIGH>,
			    <&xiao_d 8 GPIO_ACTIVE_HIGH>,
			    <&xiao_d 9 GPIO_ACTIVE_HIGH>;
		pwms = <&pwm20 0 PWM_USEC(370) PWM_POLARITY_NORMAL>;
		io-channels = <&adc 7>;
	};

	aliases {
		/delete-property/ imu0;
		imu0 = &bmi270;
	};
};

&pinctrl {
	loom_pwm_default: loom_pwm_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 6)>;
		};
	};

	loom_pwm_sleep: loom_pwm_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 6)>;
			low-power-enable;
		};
	};
};

&pwm20 {
	status = "okay";
	pinctrl-0 = <&loom_pwm_default>;
	pinctrl-1 = <&loom_pwm_sleep>;
	pinctrl-names = "default", "sleep";
};

&xiao_i2c {
	status = "okay";

	bmi270: bmi270@68 {
		compatible = "bosch,bmi270";
		reg = <0x68>;
	};
};

&lsm6ds3tr_c {
	status = "disabled";
};

&i2c30 {
	status = "disabled";
};

&pdm20 {
	status = "disabled";
};
